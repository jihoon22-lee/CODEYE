{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codeye.invalid/v0.1/go-test-failures.schema.json",
  "title": "CODEYE Go test failures v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "attempt_id", "snapshot_manifest_digest", "task_key", "stdout_sha256", "failures"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "snapshot_manifest_digest": {"$ref": "#/$defs/digest"},
    "task_key": {"type": "string", "pattern": "^test\\.go(?:\\.m[0-9]{2,})?$"},
    "stdout_sha256": {"$ref": "#/$defs/digest"},
    "failures": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "test", "path", "line", "blob_sha256", "byte_start", "byte_end"],
      "properties": {
        "package": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~+/-]{0,511}$"},
        "test": {"type": "string", "pattern": "^Test[^/\\r\\n]*$", "maxLength": 128, "description": "Go 최상위 테스트 함수 식별자."},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\r\\n]+_test\\.go$"},
        "line": {"type": "integer", "minimum": 1, "description": "고정 스냅샷에 있는 테스트 선언의 실제 줄 번호."},
        "blob_sha256": {"$ref": "#/$defs/digest"},
        "byte_start": {"type": "integer", "minimum": 0, "maximum": 8388607},
        "byte_end": {"type": "integer", "minimum": 1, "maximum": 8388608, "description": "stdout 실패 이벤트에서 LF를 제외한 끝 바이트 위치. 시작은 0부터 세고 끝은 구간에 포함하지 않는다."}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codeye.invalid/v0.1/go-vet-observations.schema.json",
  "title": "CODEYE Go vet observations artifact v0.1 (role observations, media application/vnd.codeye.observations+json)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "analyzer_id", "adapter_version", "parser_id", "parser_version", "task_key", "snapshot_manifest_digest", "module", "patterns", "tool_version", "platform", "outcome", "executions", "inventory", "coverage", "observations", "analyzer_errors", "stderr_failures", "parse", "workspace_drift", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "go_vet_observations"},
    "analyzer_id": {"const": "go.vet"},
    "adapter_version": {"type": "string", "minLength": 1},
    "parser_id": {"const": "go-vet-json-v1"},
    "parser_version": {"type": "string", "minLength": 1},
    "task_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "snapshot_manifest_digest": {"$ref": "#/$defs/sha256"},
    "module": {"type": "object", "additionalProperties": false, "required": ["dir", "path"], "properties": {"dir": {"$ref": "#/$defs/reldir"}, "path": {"type": "string"}}},
    "patterns": {"type": "array", "items": {"type": "string", "pattern": "^\\.(?:/[^/\\\\:]+)*(?:/\\.\\.\\.)?$"}},
    "tool_version": {"type": ["string", "null"], "pattern": "^go[0-9]"},
    "platform": {"type": ["string", "null"], "pattern": "^[a-z0-9]+/[a-z0-9]+$"},
    "outcome": {
      "type": "object", "additionalProperties": false, "required": ["task_status", "reason", "exit_class", "partial_parse"],
      "properties": {
        "task_status": {"enum": ["succeeded", "failed", "timed_out", "cancelled", "unsupported", "skipped_policy"]},
        "reason": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
        "exit_class": {"enum": ["success_without_findings", "success_with_findings", "configuration_error", "execution_error", "timeout", "cancelled", "not_run"]},
        "partial_parse": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"task_status": {"const": "succeeded"}}}, "then": {"properties": {"reason": {"const": null}, "exit_class": {"enum": ["success_without_findings", "success_with_findings"]}, "partial_parse": {"const": false}}}},
        {"if": {"properties": {"task_status": {"not": {"const": "succeeded"}}}}, "then": {"properties": {"reason": {"type": "string"}, "exit_class": {"not": {"enum": ["success_without_findings", "success_with_findings"]}}}}}
      ]
    },
    "executions": {"type": "array", "maxItems": 4, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "status", "exit_code", "cleanup", "command", "stdout", "stderr"],
      "properties": {
        "name": {"enum": ["go.version", "go.modedit", "go.list", "go.vet"]},
        "status": {"enum": ["exited", "timed_out", "cancelled", "rejected", "start_failed", "unsupported"]},
        "reason": {"type": "string"},
        "exit_code": {"type": ["integer", "null"]},
        "cleanup": {"enum": ["confirmed", "uncertain", "not_started"]},
        "command": {"type": "object", "additionalProperties": false, "required": ["argv", "dir", "env_keys"], "properties": {
          "argv": {"type": "array", "items": {"type": "string", "not": {"pattern": "^(?:/|\\\\|[A-Za-z]:)"}}},
          "dir": {"anyOf": [{"$ref": "#/$defs/reldir"}, {"const": "[REDACTED]"}]},
          "env_keys": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}}},
        "stdout": {"$ref": "#/$defs/stream"},
        "stderr": {"$ref": "#/$defs/stream"}
      }}},
    "inventory": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["import_path", "dir", "state", "go_files", "ignored_go_files", "errors"],
      "properties": {
        "import_path": {"type": "string"},
        "dir": {"anyOf": [{"$ref": "#/$defs/reldir"}, {"const": ""}]},
        "state": {"enum": ["analyzed_clean", "analyzed_with_findings", "failed_typecheck", "dependency_unavailable", "load_error", "not_analyzed", "unknown"]},
        "go_files": {"type": "array", "items": {"$ref": "#/$defs/relpath"}},
        "ignored_go_files": {"type": "array", "items": {"$ref": "#/$defs/relpath"}},
        "errors": {"type": "array", "items": {"type": "string"}}
      }}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["go_files_in_scope", "processed_go_files", "ignored_go_files", "unlisted_go_files", "packages"], "properties": {
      "go_files_in_scope": {"type": "integer", "minimum": 0},
      "processed_go_files": {"type": ["integer", "null"], "minimum": 0},
      "ignored_go_files": {"type": "integer", "minimum": 0},
      "unlisted_go_files": {"type": "integer", "minimum": 0},
      "packages": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}},
    "observations": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "tool", "tool_version", "rule_id", "raw_severity", "raw_message", "path", "location", "location_state", "raw_ref", "package_key", "suggested_fix_count", "related_count"],
      "properties": {
        "id": {"type": "string", "pattern": "^obs_[0-9a-f]{20}$"},
        "tool": {"const": "go.vet"},
        "tool_version": {"type": ["string", "null"]},
        "rule_id": {"type": "string", "minLength": 1},
        "raw_severity": {"const": null},
        "raw_message": {"type": "string"},
        "path": {"anyOf": [{"$ref": "#/$defs/relpath"}, {"type": "null"}]},
        "location": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["path", "start_line", "start_col", "end_line", "end_col", "column_unit", "blob_sha256"], "properties": {
          "path": {"$ref": "#/$defs/relpath"}, "start_line": {"type": "integer", "minimum": 1}, "start_col": {"type": "integer", "minimum": 0},
          "end_line": {"type": "integer", "minimum": 1}, "end_col": {"type": "integer", "minimum": 0}, "column_unit": {"const": "byte"}, "blob_sha256": {"$ref": "#/$defs/sha256"}}}]},
        "location_state": {"enum": ["resolved", "unresolved_no_position", "unresolved_outside_snapshot", "unresolved_missing_file", "unresolved_line_out_of_range", "source_drift"]},
        "raw_ref": {"$ref": "#/$defs/rawref"},
        "package_key": {"type": "string"},
        "suggested_fix_count": {"type": "integer", "minimum": 0},
        "related_count": {"type": "integer", "minimum": 0}
      },
      "if": {"properties": {"location_state": {"const": "resolved"}}},
      "then": {"properties": {"location": {"type": "object"}, "path": {"type": "string"}}},
      "else": {"properties": {"location": {"type": "null"}}}
    }},
    "analyzer_errors": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["package_key", "analyzer", "message", "raw_ref"], "properties": {
      "package_key": {"type": "string"}, "analyzer": {"type": "string"}, "message": {"type": "string"}, "raw_ref": {"$ref": "#/$defs/rawref"}}}},
    "stderr_failures": {"type": "array", "maxItems": 200, "items": {"type": "object", "additionalProperties": false, "required": ["execution", "kind", "package", "path", "line", "column", "message", "byte_offset"], "properties": {
      "execution": {"enum": ["go.list", "go.vet"]}, "kind": {"enum": ["typecheck", "position", "go_command", "other"]}, "package": {"type": "string"},
      "path": {"anyOf": [{"$ref": "#/$defs/relpath"}, {"type": "null"}]}, "line": {"type": "integer", "minimum": 0}, "column": {"type": "integer", "minimum": 0},
      "message": {"type": "string"}, "byte_offset": {"type": "integer", "minimum": 0}}}},
    "parse": {"type": "object", "additionalProperties": false, "required": ["ok", "stdout_values", "empty_values", "unparsed_bytes", "shape_errors", "list_unparsed_bytes", "stderr_lines_dropped", "observations", "unresolved_observations"], "properties": {
      "ok": {"type": "boolean"}, "stdout_values": {"type": "integer", "minimum": 0}, "empty_values": {"type": "integer", "minimum": 0},
      "unparsed_bytes": {"type": "integer", "minimum": 0}, "shape_errors": {"type": "integer", "minimum": 0}, "decode_error": {"type": "string"},
      "list_unparsed_bytes": {"type": "integer", "minimum": 0}, "list_decode_error": {"type": "string"}, "stderr_lines_dropped": {"type": "integer", "minimum": 0},
      "observations": {"type": "integer", "minimum": 0}, "unresolved_observations": {"type": "integer", "minimum": 0}}},
    "workspace_drift": {"type": "array", "items": {"$ref": "#/$defs/relpath"}},
    "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relpath": {"type": "string", "minLength": 1, "pattern": "^(?![/\\\\])(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\u0000-\\u001f]+$"},
    "reldir": {"anyOf": [{"const": "."}, {"$ref": "#/$defs/relpath"}]},
    "stream": {"type": "object", "additionalProperties": false, "required": ["sha256", "captured_bytes", "total_bytes", "truncated", "incomplete"], "properties": {
      "sha256": {"$ref": "#/$defs/sha256"}, "captured_bytes": {"type": "integer", "minimum": 0}, "total_bytes": {"type": "integer", "minimum": 0},
      "truncated": {"type": "boolean"}, "incomplete": {"type": "boolean"}}},
    "rawref": {"type": "object", "additionalProperties": false, "required": ["execution", "stream", "stream_sha256", "stream_index", "json_pointer", "byte_start", "byte_end"], "properties": {
      "execution": {"const": "go.vet"}, "stream": {"const": "stdout"}, "stream_sha256": {"$ref": "#/$defs/sha256"},
      "stream_index": {"type": "integer", "minimum": 0}, "json_pointer": {"type": "string", "pattern": "^/"},
      "byte_start": {"type": "integer", "minimum": 0}, "byte_end": {"type": "integer", "minimum": 0}}}
  }
}

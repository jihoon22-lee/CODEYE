{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codeye.invalid/v0.1/review-record.schema.json",
  "title": "CODEYE review stage record",
  "description": "application/vnd.codeye.review+json. schema_version 0.2: one review stage record (environment, documents, investigate, interpret, verify) with only its own calls (at most 3: the request, one repair, one retry of a reply that was not JSON); every upstream input is bound by the SHA-256 of the artifact bytes it read. schema_version 0.3: the record of one review slice (review.investigate.sNNN, review.verify.sNNN): 0.2 plus the required slice {key, modules}; a slice investigate also names review.scope upstream, a slice verify its own slice's investigate record and review.scope, and it carries investigate candidates only. The Go decoder (internal/worker/review/record) is authoritative: it additionally checks evidence IDs against the snapshot, the path rules of evidence kinds (code: a Go, Python, JS/TS, Rust or C/C++ source extension; test: that ecosystem's test path; manifest: a build manifest), scope rules, JSON-encoded text sizes (400 bytes of model text) and execution claims.",
  "type": "object",
  "$ref": "#/$defs/record",
  "$defs": {
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "pack", "snapshot_manifest_digest", "run_id", "attempt_id", "stage", "outcome", "upstream", "evidence", "observations", "limitations", "calls"],
      "properties": {
        "schema_version": {"enum":["0.2","0.3"]},
        "slice": {"type":"object","additionalProperties":false,"required":["key","modules"],"properties":{"key":{"type":"string","pattern":"^s(00[1-9]|0[1-8][0-9]|09[0-6])$"},"modules":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^(cpp|go|javascript|python|rust):(\\.|[^:\\u0000-\\u001f]+)$"}}}},
        "pack": {"type":"object","additionalProperties":false,"required":["id","version"],"properties":{"id":{"$ref":"#/$defs/pack_id"},"version":{"$ref":"#/$defs/version"}}},
        "snapshot_manifest_digest": {"$ref":"#/$defs/digest"},
        "run_id": {"$ref":"#/$defs/uuid"}, "attempt_id": {"$ref":"#/$defs/uuid"},
        "stage": {"$ref":"#/$defs/stage"}, "outcome": {"enum":["accepted","failed"]},
        "failure_reason": {"$ref":"#/$defs/code"},
        "upstream": {"type":"array","maxItems":16,"items":{"$ref":"#/$defs/upstream"}},
        "evidence": {"type":"array","maxItems":40,"items":{"$ref":"#/$defs/excerpt"}},
        "observations": {"type":"array","maxItems":16,"items":{"$ref":"#/$defs/observation_ref"}},
        "environment_notes": {"type":"array","minItems":1,"maxItems":4,"items":{"$ref":"#/$defs/environment_note"}},
        "contracts": {"type":"array","minItems":1,"maxItems":6,"items":{"$ref":"#/$defs/contract"}},
        "conflicts": {"type":"array","minItems":1,"maxItems":3,"items":{"$ref":"#/$defs/conflict"}},
        "questions": {"type":"array","minItems":1,"maxItems":4,"items":{"$ref":"#/$defs/question"}},
        "instruction_notes": {"type":"array","minItems":1,"maxItems":3,"items":{"$ref":"#/$defs/instruction_note"}},
        "document_quality": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["aspect", "assessment", "statement", "evidence_ids"], "properties": {"aspect": {"enum": ["clarity", "completeness", "actionability", "consistency"]}, "assessment": {"enum": ["strength", "weakness"]}, "statement": {"$ref": "#/$defs/text"}, "evidence_ids": {"$ref": "#/$defs/refs", "minItems": 1, "maxItems": 4}}}},
        "strengths": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["title", "benefit", "scope", "evidence_ids"], "properties": {"title": {"$ref": "#/$defs/text"}, "benefit": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/scope_path"}, "evidence_ids": {"$ref": "#/$defs/refs", "minItems": 1, "maxItems": 4}}}},
        "contract_comparisons": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["contract_index", "applies_to", "status", "reason", "document_evidence_ids", "code_evidence_ids"], "properties": {"contract_index": {"type": "integer", "minimum": 1, "maximum": 6}, "applies_to": {"$ref": "#/$defs/scope_path"}, "status": {"enum": ["match", "partial", "mismatch", "unknown"]}, "reason": {"$ref": "#/$defs/text"}, "document_evidence_ids": {"$ref": "#/$defs/refs", "minItems": 1, "maxItems": 4}, "code_evidence_ids": {"$ref": "#/$defs/refs", "minItems": 0, "maxItems": 4}}}},
        "candidates": {"type":"array","minItems":1,"maxItems":6,"items":{"$ref":"#/$defs/candidate"}},
        "interpretation_limits": {"type":"array","minItems":1,"maxItems":3,"items":{"$ref":"#/$defs/interpretation_limit"}},
        "verifications": {"type":"array","minItems":1,"maxItems":6,"items":{"allOf":[{"$ref":"#/$defs/verification"},{"properties":{"candidate_id":{"$ref":"#/$defs/candidate_id"}}}]}},
        "limitations": {"$ref":"#/$defs/codes"},
        "calls": {"type":"array","maxItems":3,"items":{"$ref":"#/$defs/call"}}
      },
      "allOf": [
        {"if": {"required": ["contract_comparisons"]}, "then": {"properties": {"stage": {"const": "investigate"}, "outcome": {"const": "accepted"}, "schema_version": {"const": "0.2"}}}},
        {"if": {"required": ["strengths"]}, "then": {"properties": {"stage": {"const": "investigate"}, "outcome": {"const": "accepted"}}}},
        {"if": {"required": ["document_quality"]}, "then": {"properties": {"stage": {"const": "documents"}, "outcome": {"const": "accepted"}}}},
        {"if":{"properties":{"schema_version":{"const":"0.3"}}},
         "then":{"required":["slice"],"properties":{"stage":{"enum":["investigate","verify"]},"candidates":{"items":{"properties":{"origin":{"const":"investigate"}}}}}},
         "else":{"not":{"required":["slice"]},"properties":{"upstream":{"items":{"properties":{"source":{"not":{"pattern":"^review\\.(scope|investigate\\.s[0-9]{3})$"}}}}}}}},
        {"if":{"properties":{"outcome":{"const":"failed"}}},
         "then":{"required":["failure_reason"],"not":{"anyOf":[{"required":["environment_notes"]},{"required":["contracts"]},{"required":["conflicts"]},{"required":["questions"]},{"required":["instruction_notes"]},{"required":["interpretation_limits"]}]},"properties":{"verifications":{"items":{"properties":{"verdict":{"const":"unreviewed"}}}},"calls":{"items":{"properties":{"outcome":{"not":{"const":"accepted"}}}}}}},
         "else":{"not":{"required":["failure_reason"]}}},
        {"if":{"properties":{"stage":{"const":"environment"}}},
         "then":{"not":{"anyOf":[{"required":["contracts"]},{"required":["conflicts"]},{"required":["questions"]},{"required":["instruction_notes"]},{"required":["candidates"]},{"required":["interpretation_limits"]},{"required":["verifications"]}]},
                 "properties":{"observations":{"maxItems":0},"upstream":{"items":{"properties":{"source":{"const":"env.discover"}}}},"calls":{"items":{"properties":{"role":{"const":"environment"}}}}}}},
        {"if":{"properties":{"stage":{"const":"documents"}}},
         "then":{"not":{"anyOf":[{"required":["environment_notes"]},{"required":["candidates"]},{"required":["interpretation_limits"]},{"required":["verifications"]}]},
                 "properties":{"observations":{"maxItems":0},"upstream":{"items":{"properties":{"source":{"const":"docs.discover"}}}},"calls":{"items":{"properties":{"role":{"const":"documents"}}}}}}},
        {"if":{"properties":{"stage":{"const":"investigate"}}},
         "then":{"not":{"anyOf":[{"required":["environment_notes"]},{"required":["contracts"]},{"required":["conflicts"]},{"required":["questions"]},{"required":["instruction_notes"]},{"required":["interpretation_limits"]},{"required":["verifications"]}]},
                 "properties":{"observations":{"maxItems":0},"candidates":{"maxItems":4,"items":{"properties":{"origin":{"const":"investigate"}}}},"upstream":{"items":{"properties":{"source":{"enum":["review.environment","review.documents","review.scope"]}}}},"calls":{"items":{"properties":{"role":{"const":"investigate"}}}}}}},
        {"if":{"properties":{"stage":{"const":"interpret"}}},
         "then":{"not":{"anyOf":[{"required":["environment_notes"]},{"required":["contracts"]},{"required":["conflicts"]},{"required":["questions"]},{"required":["instruction_notes"]},{"required":["verifications"]}]},
                 "properties":{"observations":{"minItems":1},"candidates":{"maxItems":2,"items":{"properties":{"origin":{"const":"interpret"}}}},"upstream":{"items":{"properties":{"source":{"pattern":"^go-vet"}}}},"calls":{"items":{"properties":{"role":{"const":"interpret"}}}}}}},
        {"if":{"properties":{"stage":{"const":"verify"}}},
         "then":{"not":{"anyOf":[{"required":["environment_notes"]},{"required":["contracts"]},{"required":["conflicts"]},{"required":["questions"]},{"required":["instruction_notes"]},{"required":["interpretation_limits"]}]},
                 "properties":{"upstream":{"items":{"properties":{"source":{"anyOf":[{"enum":["review.documents","review.investigate","review.interpret","review.scope"]},{"pattern":"^review\\.investigate\\.s[0-9]{3}$"}]}}}},"calls":{"items":{"properties":{"role":{"const":"verify"}}}}}}}
      ]
    },
    "digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "uuid": {"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "stage": {"enum":["environment","documents","investigate","interpret","verify"]},
    "pack_id": {"type":"string","pattern":"^[a-z][a-z0-9.-]{0,63}$"},
    "version": {"type":"string","pattern":"^[a-zA-Z0-9_.-]{1,64}$"},
    "code": {"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},
    "codes": {"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/code"}},
    "task_key": {"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"},
    "path": {"type":"string","minLength":1,"maxLength":4096,"pattern":"^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^:\\\\\\u0000-\\u001f\\u007f]+(?<!/)$"},
    "scope_path": {"anyOf":[{"const":"."},{"$ref":"#/$defs/path"}]},
    "text": {"type":"string","minLength":1,"maxLength":400},
    "statements": {"type":"array","maxItems":4,"items":{"type":"string","minLength":1,"maxLength":600}},
    "id": {"type":"string","pattern":"^ev_[0-9a-f]{24}$"},
    "observation_id": {"type":"string","pattern":"^obs_[0-9a-f]{20}$"},
    "observation_ids": {"type":"array","minItems":1,"maxItems":4,"uniqueItems":true,"items":{"$ref":"#/$defs/observation_id"}},
    "candidate_id": {"type":"string","pattern":"^(investigate|interpret)_[1-4]$"},
    "refs": {"type":"array","uniqueItems":true,"maxItems":8,"items":{"$ref":"#/$defs/id"}},
    "citations": {"$ref":"#/$defs/refs","minItems":1,"maxItems":6},
    "excerpt": {
      "type":"object","additionalProperties":false,"required":["id","path","sha256","start_line","end_line","kind"],
      "properties": {
        "id":{"$ref":"#/$defs/id"}, "path":{"$ref":"#/$defs/path"},
        "sha256":{"$ref":"#/$defs/digest"}, "start_line":{"type":"integer","minimum":1},"end_line":{"type":"integer","minimum":1},
        "kind":{"enum":["code","test","document","manifest"]},"origin":{"enum":["context","caller","test","observation"]},"symbol":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
        "directive_path":{"$ref":"#/$defs/path","description":"Python docstring을 공개 문서에 연결하는 스냅샷 Markdown 페이지 경로."}
      },
      "allOf": [
        {"if":{"properties":{"kind":{"enum":["document","manifest"]}}},"then":{"not":{"required":["origin"]}}},
        {"if":{"required":["origin"],"properties":{"origin":{"enum":["caller","test"]}}},"then":{"required":["symbol"]},"else":{"not":{"required":["symbol"]}}},
        {"if":{"required":["directive_path"]},"then":{"properties":{"kind":{"const":"document"},"path":{"pattern":"\\.py$"}}}}
      ]
    },
    "upstream": {
      "type":"object","additionalProperties":false,"required":["source","state"],
      "properties": {"source":{"$ref":"#/$defs/task_key"},"state":{"enum":["accepted","skipped","failed","unavailable"]},"reason":{"$ref":"#/$defs/code"},"sha256":{"$ref":"#/$defs/digest"}},
      "if":{"properties":{"state":{"const":"accepted"}}},"then":{"required":["sha256"],"not":{"required":["reason"]}},"else":{"required":["reason"],"not":{"required":["sha256"]}}
    },
    "observation_ref": {
      "type":"object","additionalProperties":false,"required":["id","task_key","tool","rule_id"],
      "properties": {"id":{"$ref":"#/$defs/observation_id"},"task_key":{"$ref":"#/$defs/task_key"},"tool":{"type":"string","pattern":"^[a-z][a-z0-9_.]{0,63}$"},"rule_id":{"type":"string","minLength":1,"maxLength":64},
        "path":{"$ref":"#/$defs/path"},"start_line":{"type":"integer","minimum":1}},
      "dependentRequired": {"path":["start_line"],"start_line":["path"]}
    },
    "environment_note": {
      "type":"object","additionalProperties":false,"required":["module","requirement_ids","evidence_ids","affected_checks","still_checkable","needed_observation"],
      "properties": {
        "module":{"type":"string","pattern":"^(cpp|go|javascript|python|rust):(\\.|[^:\\u0000-\\u001f]+)$"},
        "requirement_ids":{"type":"array","maxItems":4,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}@[^@\\u0000-\\u001f]+$"}},
        "evidence_ids":{"$ref":"#/$defs/refs","maxItems":4},
        "affected_checks":{"$ref":"#/$defs/text"},"still_checkable":{"$ref":"#/$defs/text"},"needed_observation":{"$ref":"#/$defs/text"}
      }
    },
    "contract": {
      "type":"object","additionalProperties":false,"required":["statement","applies_to","evidence_ids"],
      "properties":{"statement":{"$ref":"#/$defs/text"},"applies_to":{"$ref":"#/$defs/scope_path"},"evidence_ids":{"$ref":"#/$defs/refs","minItems":1,"maxItems":4}}
    },
    "conflict": {
      "type":"object","additionalProperties":false,"required":["scope","summary","impact","first_evidence_ids","second_evidence_ids"],
      "properties":{"scope":{"$ref":"#/$defs/scope_path"},"summary":{"$ref":"#/$defs/text"},"impact":{"$ref":"#/$defs/text"},
        "first_evidence_ids":{"$ref":"#/$defs/refs","minItems":1,"maxItems":3},"second_evidence_ids":{"$ref":"#/$defs/refs","minItems":1,"maxItems":3}}
    },
    "question": {
      "type":"object","additionalProperties":false,"required":["question","applies_to","evidence_ids"],
      "properties":{"question":{"$ref":"#/$defs/text"},"applies_to":{"$ref":"#/$defs/scope_path"},"evidence_ids":{"$ref":"#/$defs/refs","minItems":1,"maxItems":4}}
    },
    "instruction_note": {
      "type":"object","additionalProperties":false,"required":["note","evidence_ids"],
      "properties":{"note":{"$ref":"#/$defs/text"},"evidence_ids":{"$ref":"#/$defs/refs","minItems":1,"maxItems":3}}
    },
    "interpretation_limit": {
      "type":"object","additionalProperties":false,"required":["observation_ids","statement"],
      "properties":{"observation_ids":{"$ref":"#/$defs/observation_ids"},"statement":{"$ref":"#/$defs/text"}}
    },
    "candidate": {
      "type":"object","additionalProperties":false,"required":["id","title","condition","impact","improvement","counterpoint","evidence_ids","origin"],
      "properties":{"id":{"$ref":"#/$defs/candidate_id"},"title":{"$ref":"#/$defs/text"},"condition":{"$ref":"#/$defs/text"},"impact":{"$ref":"#/$defs/text"},"improvement":{"$ref":"#/$defs/text"},"counterpoint":{"$ref":"#/$defs/text"},
        "evidence_ids":{"$ref":"#/$defs/citations"},"origin":{"enum":["investigate","interpret"]},"observation_ids":{"$ref":"#/$defs/observation_ids"}},
      "if":{"properties":{"origin":{"const":"interpret"}}},"then":{"required":["observation_ids"],"properties":{"id":{"pattern":"^interpret_"}}},"else":{"not":{"required":["observation_ids"]},"properties":{"id":{"pattern":"^investigate_"}}}
    },
    "verification": {
      "type":"object","additionalProperties":false,
      "required":["candidate_id","verdict","category","severity","severity_reason","impact","valid_conditions","invalid_conditions","supporting_evidence_ids","counterevidence_ids","unresolved_assumptions","next_verification","limitations"],
      "properties": {
        "candidate_id":{"type":"string"},"verdict":{"enum":["supported","refuted","inconclusive","unreviewed"]},
        "category":{"enum":["","correctness","error_handling","concurrency","resource_lifecycle","data_integrity","api_contract","security","maintainability","performance","test_gap"]},
        "severity":{"enum":["","high","medium","low","info"]},"severity_reason":{"type":"string","maxLength":2400},"impact":{"type":"string","maxLength":2400},
        "valid_conditions":{"$ref":"#/$defs/statements"},"invalid_conditions":{"$ref":"#/$defs/statements"},
        "supporting_evidence_ids":{"$ref":"#/$defs/refs"},"counterevidence_ids":{"$ref":"#/$defs/refs"},
        "unresolved_assumptions":{"$ref":"#/$defs/statements"},"next_verification":{"$ref":"#/$defs/statements","maxItems":3},"limitations":{"$ref":"#/$defs/codes"}
      },
      "allOf":[
        {"if":{"properties":{"verdict":{"const":"unreviewed"}}},"then":{"properties":{"category":{"const":""},"severity":{"const":""},"severity_reason":{"const":""},"impact":{"const":""},"valid_conditions":{"maxItems":0},"invalid_conditions":{"maxItems":0},"supporting_evidence_ids":{"maxItems":0},"counterevidence_ids":{"maxItems":0},"unresolved_assumptions":{"maxItems":0},"next_verification":{"maxItems":0},"limitations":{"minItems":1}}},"else":{"properties":{"category":{"minLength":1},"severity":{"minLength":1},"severity_reason":{"minLength":1},"impact":{"minLength":1},"next_verification":{"minItems":1}}}},
        {"if":{"properties":{"verdict":{"const":"supported"}}},"then":{"properties":{"valid_conditions":{"minItems":1},"supporting_evidence_ids":{"minItems":1}}}},
        {"if":{"properties":{"verdict":{"const":"refuted"}}},"then":{"properties":{"invalid_conditions":{"minItems":1},"counterevidence_ids":{"minItems":1}}}}
      ]
    },
    "call": {
      "type":"object","additionalProperties":false,
      "required":["role","model","opencode_version","pack_id","pack_version","pack_sha256","pack_files","request_sha256","request_bytes","usage","attempt","outcome","output_errors"],
      "properties": {
        "role":{"$ref":"#/$defs/stage"},"model":{"type":"string","maxLength":160},"opencode_version":{"type":"string","maxLength":64},
        "pack_id":{"$ref":"#/$defs/pack_id"},"pack_version":{"$ref":"#/$defs/version"},
        "pack_sha256":{"$ref":"#/$defs/digest"},"pack_files":{"type":"array","minItems":1,"maxItems":24,"uniqueItems":true,"items":{"$ref":"#/$defs/path"}},
        "request_sha256":{"oneOf":[{"$ref":"#/$defs/digest"},{"const":""}]},"request_bytes":{"type":"integer","minimum":0},"attempt":{"type":"integer","minimum":1,"maximum":3},
        "outcome":{"$ref":"#/$defs/code"},"output_errors":{"$ref":"#/$defs/codes"},
        "usage":{"type":["object","null"],"additionalProperties":false,"required":["input","output"],"properties":{"input":{"type":"integer","minimum":0},"output":{"type":"integer","minimum":0}}}
      }
    }
  }
}

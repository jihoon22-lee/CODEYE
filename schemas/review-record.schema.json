{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codeye.invalid/v0.1/review-record.schema.json",
  "title": "CODEYE context, investigation and verifier record",
  "description": "application/vnd.codeye.review+json. Records contain references to immutable evidence and cumulative call metadata.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "snapshot_manifest_digest", "run_id", "attempt_id", "stage", "evidence", "facts", "candidates", "limitations", "calls"],
  "properties": {
    "schema_version": {"const":"0.1"},
    "snapshot_manifest_digest": {"$ref":"#/$defs/digest"},
    "run_id": {"$ref":"#/$defs/uuid"}, "attempt_id": {"$ref":"#/$defs/uuid"},
    "stage": {"$ref":"#/$defs/role"}, "outcome": {"enum":["accepted","failed"]},
    "failure_reason": {"$ref":"#/$defs/code"},
    "evidence": {"type":"array","minItems":1,"maxItems":12,"items":{"$ref":"#/$defs/excerpt"}},
    "facts": {"type":"array","maxItems":4,"items":{"$ref":"#/$defs/fact"}},
    "candidates": {"type":"array","maxItems":4,"items":{"$ref":"#/$defs/candidate"}},
    "verifications": {"type":"array","maxItems":4,"items":{"$ref":"#/$defs/verification"}},
    "limitations": {"$ref":"#/$defs/codes"},
    "calls": {"type":"array","maxItems":4,"items":{"$ref":"#/$defs/call"}}
  },
  "allOf": [
    {"if":{"properties":{"stage":{"const":"verify"}}},"then":{"required":["outcome"]},"else":{"not":{"required":["verifications"]}}},
    {"if":{"properties":{"stage":{"const":"context"}}},"then":{"properties":{"candidates":{"maxItems":0}}}},
    {"if":{"required":["outcome"],"properties":{"outcome":{"const":"failed"}}},"then":{"required":["failure_reason"],"properties":{"verifications":{"items":{"properties":{"verdict":{"const":"unreviewed"}}}}}},"else":{"not":{"required":["failure_reason"]},"properties":{"facts":{"minItems":1}}}}
  ],
  "$defs": {
    "digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "uuid": {"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "role": {"enum":["context","investigate","verify"]},
    "code": {"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},
    "codes": {"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/code"}},
    "text": {"type":"string","minLength":1,"maxLength":2400},
    "statements": {"type":"array","maxItems":4,"items":{"type":"string","minLength":1,"maxLength":600}},
    "id": {"type":"string","pattern":"^ev_[0-9a-f]{24}$"},
    "candidate_id": {"type":"string","pattern":"^candidate_[1-4]$"},
    "refs": {"type":"array","uniqueItems":true,"maxItems":8,"items":{"$ref":"#/$defs/id"}},
    "citations": {"$ref":"#/$defs/refs","minItems":1,"maxItems":6},
    "excerpt": {
      "type":"object","additionalProperties":false,"required":["id","path","sha256","start_line","end_line","kind"],
      "properties": {
        "id":{"$ref":"#/$defs/id"}, "path":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^:\\\\\\u0000-\\u001f\\u007f]+(?<!/)$"},
        "sha256":{"$ref":"#/$defs/digest"}, "start_line":{"type":"integer","minimum":1},"end_line":{"type":"integer","minimum":1},
        "kind":{"enum":["code","test","document","config"]},"origin":{"enum":["context","caller","test"]},"symbol":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]{0,127}$"}
      }
    },
    "fact": {
      "type":"object","additionalProperties":false,"required":["kind","statement","evidence_ids"],
      "properties":{"kind":{"enum":["documented","observed","inferred"]},"statement":{"$ref":"#/$defs/text"},"evidence_ids":{"$ref":"#/$defs/citations"}}
    },
    "candidate": {
      "type":"object","additionalProperties":false,"required":["id","title","condition","impact","improvement","counterpoint","evidence_ids"],
      "properties":{"id":{"$ref":"#/$defs/candidate_id"},"title":{"$ref":"#/$defs/text"},"condition":{"$ref":"#/$defs/text"},"impact":{"$ref":"#/$defs/text"},"improvement":{"$ref":"#/$defs/text"},"counterpoint":{"$ref":"#/$defs/text"},"evidence_ids":{"$ref":"#/$defs/citations"}}
    },
    "verification": {
      "type":"object","additionalProperties":false,
      "required":["candidate_id","verdict","category","severity","severity_reason","impact","valid_conditions","invalid_conditions","supporting_evidence_ids","counterevidence_ids","unresolved_assumptions","next_verification","limitations"],
      "properties": {
        "candidate_id":{"$ref":"#/$defs/candidate_id"},"verdict":{"enum":["supported","refuted","inconclusive","unreviewed"]},
        "category":{"enum":["","correctness","error_handling","concurrency","resource_lifecycle","data_integrity","api_contract","security","maintainability","performance","test_gap"]},
        "severity":{"enum":["","high","medium","low","info"]},"severity_reason":{"type":"string","maxLength":2400},"impact":{"type":"string","maxLength":2400},
        "valid_conditions":{"$ref":"#/$defs/statements"},"invalid_conditions":{"$ref":"#/$defs/statements"},
        "supporting_evidence_ids":{"$ref":"#/$defs/refs"},"counterevidence_ids":{"$ref":"#/$defs/refs"},
        "unresolved_assumptions":{"$ref":"#/$defs/statements"},"next_verification":{"$ref":"#/$defs/statements","maxItems":3},"limitations":{"$ref":"#/$defs/codes"}
      },
      "allOf":[
        {"if":{"properties":{"verdict":{"const":"unreviewed"}}},"then":{"properties":{"category":{"const":""},"severity":{"const":""},"severity_reason":{"const":""},"impact":{"const":""},"valid_conditions":{"maxItems":0},"invalid_conditions":{"maxItems":0},"supporting_evidence_ids":{"maxItems":0},"counterevidence_ids":{"maxItems":0},"unresolved_assumptions":{"maxItems":0},"next_verification":{"maxItems":0},"limitations":{"minItems":1}}},"else":{"properties":{"category":{"minLength":1},"severity":{"minLength":1},"severity_reason":{"minLength":1},"impact":{"minLength":1},"next_verification":{"minItems":1}}}},
        {"if":{"properties":{"verdict":{"const":"supported"}}},"then":{"properties":{"valid_conditions":{"minItems":1},"supporting_evidence_ids":{"minItems":1}}}},
        {"if":{"properties":{"verdict":{"const":"refuted"}}},"then":{"properties":{"invalid_conditions":{"minItems":1},"counterevidence_ids":{"minItems":1}}}}
      ]
    },
    "call": {
      "type":"object","additionalProperties":false,"required":["role","model","opencode_version","pack_sha256","pack_files","request_sha256","usage"],
      "properties": {
        "role":{"$ref":"#/$defs/role"},"model":{"type":"string","maxLength":160},"opencode_version":{"type":"string","maxLength":64},
        "pack_sha256":{"$ref":"#/$defs/digest"},"pack_files":{"type":"array","minItems":1,"maxItems":24,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "request_sha256":{"oneOf":[{"$ref":"#/$defs/digest"},{"const":""}]},"attempt":{"type":"integer","minimum":1,"maximum":2},"outcome":{"$ref":"#/$defs/code"},
        "usage":{"type":["object","null"],"additionalProperties":false,"required":["input","output"],"properties":{"input":{"type":"integer","minimum":0},"output":{"type":"integer","minimum":0}}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeye.invalid/schemas/doctor.schema.json",
  "title": "CODEYE foundation diagnostics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "host",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "stage": {
      "const": "foundation"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "logical_cpus",
        "memory_total_bytes",
        "disk_available_bytes"
      ],
      "properties": {
        "os": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "arch": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "logical_cpus": {
          "type": "integer",
          "minimum": 1
        },
        "memory_total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "disk_available_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "enum": [
              "host",
              "work_disk",
              "git",
              "go",
              "node",
              "rust",
              "postgres_client",
              "opencode_cli",
              "analyzers",
              "configured_tools",
              "database"
            ]
          },
          "status": {
            "enum": [
              "available",
              "unavailable",
              "unverified",
              "not_configured"
            ]
          },
          "reason": {
            "enum": [
              "observed_runtime",
              "directory_unavailable",
              "write_failed",
              "readback_failed",
              "cleanup_failed",
              "write_read_remove_verified",
              "version_only",
              "executable_missing",
              "permission_denied",
              "invalid_executable",
              "workspace_unavailable",
              "recovery_required",
              "output_limit",
              "probe_failed",
              "version_unrecognized",
              "database_url_missing",
              "invalid_database_url",
              "unsupported_database_option",
              "unsupported_tls_mode",
              "tls_required",
              "authentication_failed",
              "database_missing",
              "connection_failed",
              "server_version_unrecognized",
              "authenticated_query_verified",
              "baseline_analyzer_usable",
              "no_baseline_analyzer",
              "configured_tools_usable",
              "configured_tool_unusable"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
          },
          "blocking": {
            "description": "True when a failure of this check makes the exit code 1: it matters for the mode doctor was asked about.",
            "type": "boolean"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "host"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "work_disk"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "git"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "go"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "node"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "rust"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "postgres_client"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "opencode_cli"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "analyzers"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "configured_tools"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "database"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "operations": {
      "description": "Personal operations (codeye doctor --config): storage use per area against the configured quota, the newest backup and the start/stop process state. Absent without --config.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage",
        "backup",
        "processes"
      ],
      "properties": {
        "storage": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "area",
              "status",
              "bytes",
              "limit_bytes",
              "filesystem_available_bytes",
              "incomplete",
              "enforcement"
            ],
            "properties": {
              "area": {
                "enum": [
                  "snapshot",
                  "workspace",
                  "cache",
                  "logs",
                  "artifacts"
                ]
              },
              "status": {
                "enum": [
                  "within_limit",
                  "over_limit",
                  "no_limit",
                  "unmeasured"
                ]
              },
              "bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "limit_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "filesystem_available_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "incomplete": {
                "type": "boolean"
              },
              "enforcement": {
                "enum": [
                  "claim_refusal_node_heartbeat",
                  "claim_refusal_database_accounting"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "unmeasured"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "bytes": {
                      "type": "null"
                    },
                    "incomplete": {
                      "const": false
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "within_limit",
                        "over_limit",
                        "no_limit"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "bytes": {
                      "type": "integer"
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "within_limit",
                        "over_limit"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "limit_bytes": {
                      "type": "integer"
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "no_limit"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "limit_bytes": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "area": {
                      "enum": [
                        "artifacts"
                      ]
                    }
                  },
                  "required": [
                    "area"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "enforcement": {
                      "const": "claim_refusal_database_accounting"
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "area": {
                      "enum": [
                        "snapshot",
                        "workspace",
                        "cache",
                        "logs"
                      ]
                    }
                  },
                  "required": [
                    "area"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "enforcement": {
                      "const": "claim_refusal_node_heartbeat"
                    }
                  }
                }
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "area": {
                    "const": "snapshot"
                  }
                },
                "required": [
                  "area"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "area": {
                    "const": "workspace"
                  }
                },
                "required": [
                  "area"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "area": {
                    "const": "cache"
                  }
                },
                "required": [
                  "area"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "area": {
                    "const": "logs"
                  }
                },
                "required": [
                  "area"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "area": {
                    "const": "artifacts"
                  }
                },
                "required": [
                  "area"
                ]
              }
            }
          ]
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "latest",
            "created_at",
            "age_seconds"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_configured",
                "none",
                "unreadable",
                "recent",
                "stale"
              ]
            },
            "latest": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 255
            },
            "created_at": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "age_seconds": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "recent",
                      "stale"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "latest": {
                    "type": "string"
                  },
                  "created_at": {
                    "type": "string"
                  },
                  "age_seconds": {
                    "type": "integer"
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "not_configured",
                      "none",
                      "unreadable"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "latest": {
                    "type": "null"
                  },
                  "created_at": {
                    "type": "null"
                  },
                  "age_seconds": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "processes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "controller",
            "agent",
            "issues"
          ],
          "properties": {
            "status": {
              "enum": [
                "consistent",
                "inconsistent",
                "unsupported"
              ]
            },
            "controller": {
              "enum": [
                "running",
                "exited",
                "pid_reused",
                "not_recorded",
                "unknown"
              ]
            },
            "agent": {
              "enum": [
                "running",
                "exited",
                "pid_reused",
                "not_recorded",
                "unknown"
              ]
            },
            "issues": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 6,
              "items": {
                "enum": [
                  "stale_record",
                  "agent_running_without_record",
                  "listen_in_use_without_record",
                  "partially_running",
                  "record_unreadable",
                  "operation_in_progress"
                ]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "consistent"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "issues": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "inconsistent"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "issues": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      }
    },
    "tools": {
      "description": "The tools detection found, searched the way the agent searches them (docs/ANALYZERS.md). No paths.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "version_tested"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          },
          "status": {
            "enum": [
              "found",
              "not_found",
              "unusable"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "version_tested": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "offline": {
      "description": "Offline readiness (codeye doctor --config, docs/OPERATIONS.md#오프라인-준비-점검): every outbound destination the configuration leads to and where it comes from, the CA bundle, the PostgreSQL programs and what each language misses without the internet. No file path. Absent without --config.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ca_bundle",
        "destinations",
        "postgres",
        "languages"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ca_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_configured",
                "available",
                "unavailable"
              ]
            },
            "certificates": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "enum": [
                "ca_bundle_unreadable"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "available"
                  }
                },
                "type": "object"
              },
              "then": {
                "required": [
                  "certificates"
                ],
                "properties": {
                  "certificates": {
                    "type": "integer"
                  },
                  "reason": false
                },
                "type": "object"
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unavailable"
                  }
                },
                "type": "object"
              },
              "then": {
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "certificates": false
                },
                "type": "object"
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "not_configured"
                  }
                },
                "type": "object"
              },
              "then": {
                "properties": {
                  "reason": false,
                  "certificates": false
                },
                "type": "object"
              }
            }
          ]
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "origin"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "go_proxy",
                  "go_sumdb",
                  "npm_registry",
                  "pip_index",
                  "crates_registry",
                  "git_host",
                  "github_api",
                  "model_endpoint"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "not": {
                  "pattern": "[a-zA-Z][a-zA-Z0-9+.-]*://[^/]*@"
                }
              },
              "origin": {
                "enum": [
                  "config",
                  "user_go_env",
                  "user_npm_config",
                  "model_key_file",
                  "relay_file",
                  "builtin_default",
                  "none"
                ]
              },
              "reason": {
                "enum": [
                  "offline_no_registry_configured",
                  "checksum_database_off",
                  "dependency_fetch_disabled",
                  "git_hosts_empty",
                  "offline_mode",
                  "github_disabled",
                  "model_not_configured",
                  "model_endpoint_not_configured"
                ]
              }
            },
            "if": {
              "properties": {
                "origin": {
                  "const": "none"
                }
              },
              "type": "object"
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string"
                },
                "value": false
              },
              "type": "object"
            },
            "else": {
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string"
                },
                "reason": false
              },
              "type": "object"
            }
          }
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "programs"
          ],
          "properties": {
            "status": {
              "enum": [
                "found",
                "not_found"
              ]
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            },
            "source": {
              "enum": [
                "--postgres-bin-dir",
                "database.postgres_bin_dir",
                "CODEYE_POSTGRES_BIN_DIR",
                "PATH",
                "system"
              ]
            },
            "programs": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "status"
                ],
                "properties": {
                  "name": {
                    "enum": [
                      "initdb",
                      "pg_ctl",
                      "postgres",
                      "pg_dump",
                      "pg_restore",
                      "psql"
                    ]
                  },
                  "status": {
                    "enum": [
                      "found",
                      "not_found"
                    ]
                  }
                }
              }
            }
          }
        },
        "languages": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language",
              "status",
              "missing",
              "dependencies"
            ],
            "properties": {
              "language": {
                "enum": [
                  "go",
                  "python",
                  "javascript",
                  "rust",
                  "cpp",
                  "common",
                  "model"
                ]
              },
              "status": {
                "enum": [
                  "ready",
                  "partial",
                  "unavailable"
                ]
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_|-]{0,63}$"
                }
              },
              "dependencies": {
                "enum": [
                  "internal_registry",
                  "operator_cache",
                  "builtin_default",
                  "fetch_disabled",
                  "none",
                  "not_fetched"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "ready"
                    }
                  },
                  "type": "object"
                },
                "then": {
                  "properties": {
                    "missing": {
                      "maxItems": 0,
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "partial",
                        "unavailable"
                      ]
                    }
                  },
                  "type": "object"
                },
                "then": {
                  "properties": {
                    "missing": {
                      "minItems": 1,
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            ]
          }
        }
      }
    }
  }
}

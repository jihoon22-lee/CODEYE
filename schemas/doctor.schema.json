{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeye.invalid/schemas/doctor.schema.json",
  "title": "CODEYE foundation diagnostics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "host",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "stage": {
      "const": "foundation"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "logical_cpus",
        "memory_total_bytes",
        "disk_available_bytes"
      ],
      "properties": {
        "os": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "arch": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "logical_cpus": {
          "type": "integer",
          "minimum": 1
        },
        "memory_total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "disk_available_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "enum": [
              "host",
              "work_disk",
              "git",
              "go",
              "node",
              "python",
              "c_cpp",
              "rust",
              "postgres_client",
              "opencode_cli",
              "database",
              "model",
              "process_control"
            ]
          },
          "status": {
            "enum": [
              "available",
              "unavailable",
              "unverified",
              "not_configured"
            ]
          },
          "reason": {
            "enum": [
              "observed_runtime",
              "directory_unavailable",
              "write_failed",
              "readback_failed",
              "cleanup_failed",
              "write_read_remove_verified",
              "version_only",
              "executable_missing",
              "permission_denied",
              "invalid_executable",
              "workspace_unavailable",
              "recovery_required",
              "output_limit",
              "probe_failed",
              "version_unrecognized",
              "database_url_missing",
              "invalid_database_url",
              "unsupported_database_option",
              "unsupported_tls_mode",
              "tls_required",
              "authentication_failed",
              "database_missing",
              "connection_failed",
              "server_version_unrecognized",
              "authenticated_query_verified",
              "adapter_contract_pending_w10",
              "native_executor_pending_w05",
              "runtime_process_control_not_probed"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "host"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "work_disk"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "git"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "go"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "node"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "python"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "c_cpp"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "rust"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "postgres_client"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "opencode_cli"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "database"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "model"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "process_control"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "operations": {
      "description": "W25 personal operations (codeye doctor --config): storage use per area against the configured quota, the newest backup and the start/stop process state. Absent without --config.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage",
        "backup",
        "processes"
      ],
      "properties": {
        "storage": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "area",
              "status",
              "bytes",
              "limit_bytes",
              "filesystem_available_bytes",
              "incomplete",
              "enforcement"
            ],
            "properties": {
              "area": {
                "enum": [
                  "snapshot",
                  "workspace",
                  "cache",
                  "logs",
                  "artifacts"
                ]
              },
              "status": {
                "enum": [
                  "within_limit",
                  "over_limit",
                  "no_limit",
                  "unmeasured"
                ]
              },
              "bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "limit_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "filesystem_available_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "incomplete": {
                "type": "boolean"
              },
              "enforcement": {
                "enum": [
                  "claim_refusal_node_heartbeat",
                  "claim_refusal_database_accounting"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "unmeasured"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "bytes": {
                      "type": "null"
                    },
                    "incomplete": {
                      "const": false
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "within_limit",
                        "over_limit",
                        "no_limit"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "bytes": {
                      "type": "integer"
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "within_limit",
                        "over_limit"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "limit_bytes": {
                      "type": "integer"
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "no_limit"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "limit_bytes": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "area": {
                      "enum": [
                        "artifacts"
                      ]
                    }
                  },
                  "required": [
                    "area"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "enforcement": {
                      "const": "claim_refusal_database_accounting"
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "area": {
                      "enum": [
                        "snapshot",
                        "workspace",
                        "cache",
                        "logs"
                      ]
                    }
                  },
                  "required": [
                    "area"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "enforcement": {
                      "const": "claim_refusal_node_heartbeat"
                    }
                  }
                }
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "area": {
                    "const": "snapshot"
                  }
                },
                "required": [
                  "area"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "area": {
                    "const": "workspace"
                  }
                },
                "required": [
                  "area"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "area": {
                    "const": "cache"
                  }
                },
                "required": [
                  "area"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "area": {
                    "const": "logs"
                  }
                },
                "required": [
                  "area"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "area": {
                    "const": "artifacts"
                  }
                },
                "required": [
                  "area"
                ]
              }
            }
          ]
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "latest",
            "created_at",
            "age_seconds"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_configured",
                "none",
                "unreadable",
                "recent",
                "stale"
              ]
            },
            "latest": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 255
            },
            "created_at": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "age_seconds": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "recent",
                      "stale"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "latest": {
                    "type": "string"
                  },
                  "created_at": {
                    "type": "string"
                  },
                  "age_seconds": {
                    "type": "integer"
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "not_configured",
                      "none",
                      "unreadable"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "latest": {
                    "type": "null"
                  },
                  "created_at": {
                    "type": "null"
                  },
                  "age_seconds": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "processes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "controller",
            "agent",
            "issues"
          ],
          "properties": {
            "status": {
              "enum": [
                "consistent",
                "inconsistent",
                "unsupported"
              ]
            },
            "controller": {
              "enum": [
                "running",
                "exited",
                "pid_reused",
                "not_recorded",
                "unknown"
              ]
            },
            "agent": {
              "enum": [
                "running",
                "exited",
                "pid_reused",
                "not_recorded",
                "unknown"
              ]
            },
            "issues": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 6,
              "items": {
                "enum": [
                  "stale_record",
                  "agent_running_without_record",
                  "listen_in_use_without_record",
                  "partially_running",
                  "record_unreadable",
                  "operation_in_progress"
                ]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "consistent"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "issues": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "inconsistent"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "issues": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codeye.invalid/v0.1/report.schema.json",
  "title": "CODEYE report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "demo", "id", "run_id", "revision", "created_at", "status", "quality_verdict", "inputs", "summary", "coverage", "tasks", "findings", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "demo": {"type": "boolean"},
    "id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["completed", "partial", "failed", "cancelled"]},
    "quality_verdict": {"enum": ["attention_required", "no_actionable_findings", "inconclusive"]},
    "project": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": {"type":"string","minLength":1}, "source":{"type":"string"},
        "started_at":{"type":"string","format":"date-time"}, "finished_at":{"type":"string","format":"date-time"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "source_kind", "description"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["git", "local", "synthetic"]},
        "description": {"type": "string"},
        "commit_sha": {"type": ["string", "null"]},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile": {"enum": ["deep-review", "with-tests", "focused"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_findings", "actionable_findings", "pending_candidates", "refuted_findings", "priorities"],
      "properties": {
        "total_findings": {"type": "integer", "minimum": 0},
        "actionable_findings": {"type": "integer", "minimum": 0},
        "pending_candidates": {"type": "integer", "minimum": 0},
        "refuted_findings": {"type": "integer", "minimum": 0},
        "priorities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "raw_observations": {"type": "integer", "minimum": 0},
        "unresolved_observations": {"type": "integer", "minimum": 0},
        "hidden_findings": {"type": "integer", "minimum": 1, "description": "게시 시점의 사람 disposition으로 조치 수에서 숨긴 발견 수(0이면 생략). 전체 수와 비교에는 남는다."},
        "metric_observations": {"type": "integer", "minimum": 1, "description": "docs/ANALYZERS.md: raw_observations 중 구조 지표(복잡도·중복) 관찰 수(0이면 생략). 결함·finding·조치 수가 아니다."}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_mode", "inventory_files", "tool_processed_files", "llm_exposed_files", "test_status", "notes"],
      "properties": {
        "scope_mode": {"enum": ["full", "paths", "pr"]},
        "inventory_files": {"type": "integer", "minimum": 0},
        "tool_processed_files": {"type": ["integer", "null"], "minimum": 0},
        "llm_exposed_files": {"type": ["integer", "null"], "minimum": 0},
        "test_status": {"enum": ["no_tests", "not_run", "passed", "failed"]},
        "notes": {"type": "array", "items": {"type": "string"}},
        "review_calls": {"type": "array", "maxItems": 207, "items": {"$ref": "#/$defs/reviewCall"}},
        "ai_review": {"$ref": "#/$defs/aiReview"},
        "tools": {"type": "array", "items": {"$ref": "#/$defs/toolCoverage"}}
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "required_for_verdict", "reason"],
        "properties": {
          "id": {"type": "string"},
          "status": {
            "enum": ["succeeded", "failed", "timed_out", "cancelled", "unsupported", "skipped_policy", "budget_exhausted"]
          },
          "required_for_verdict": {"type": "boolean"},
          "reason": {"type": ["string", "null"]},
          "key": {"type": "string"}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "input_digest", "result_manifest_artifact_id"],
      "properties": {
        "id": {"const": "codeye-report"},
        "version": {"type": "string"},
        "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_manifest_artifact_id": {"type": ["string", "null"]}
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_code"],
      "properties": {"include_code": {"type": "boolean"}}
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "lease_epoch", "completion_status", "cleanup_state", "reason"],
      "properties": {
        "id": {"type": "string"},
        "number": {"type": "integer", "minimum": 1},
        "lease_epoch": {"type": "integer", "minimum": 1},
        "completion_status": {"type": "string"},
        "cleanup_state": {"type": "string"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "executions": {"type": "array", "items": {"$ref": "#/$defs/execution"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "overview": {"$ref": "#/$defs/overview"},
    "environment": {"$ref": "#/$defs/environmentSection"},
    "documents": {"$ref": "#/$defs/documentsSection"},
    "static_analysis": {"$ref": "#/$defs/staticAnalysisSection"},
    "metrics": {"$ref": "#/$defs/metricsSection"},
    "secrets": {"$ref": "#/$defs/secretsSection"},
    "code_review": {"$ref": "#/$defs/codeReviewSection"},
    "gaps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gap"}, "description": "분석 공백. 비어 있으면 생략하고 overview의 gaps 줄이 수를 싣는다."},
    "pull_request": {"$ref": "#/$defs/pull_request", "description": "pull request run에만 있다(builder 9). 고정한 pull request, 모델에 보낸 변경 파일 수, 변경 부분과 기존 부분으로 나눈 발견·도구 진단 수(docs/REPORT.md#pull-request-보고서)."}
  },
  "$comment": "builder 5 분석 종류별 절(docs/REPORT.md#분석-종류별-절)은 모두 선택이며 함께 있거나 함께 없다. builder 4 이하 리비전에는 없다. builder 6부터 code_review.ledger(모듈별 검토 장부, review.scope가 계획된 실행만)와 review_calls[].task_key가 더해진다. builder 8은 schema 0.2 범위 산출물(검토 우선순위, docs/REVIEW.md#검토-우선순위)에서 장부 행의 class·부차 파일 수와 primary_slots_budget_exhausted를 더하고, slot 키는 s001~s096이다.",
  "dependentRequired": {"overview": ["environment", "documents", "static_analysis", "metrics", "secrets", "code_review"], "environment": ["overview"], "documents": ["overview"], "static_analysis": ["overview"], "metrics": ["overview"], "secrets": ["overview"], "code_review": ["overview"], "gaps": ["overview"]},
  "$defs": {
    "reviewCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "model", "opencode_version", "pack_sha256", "request_sha256", "outcome", "pack_id", "pack_version"],
      "properties": {
        "role": {"enum": ["environment", "documents", "investigate", "interpret", "verify"]},
        "model": {"type": "string", "maxLength": 160},
        "opencode_version": {"type": "string", "maxLength": 64},
        "pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "request_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
        "outcome": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$"},
        "pack_version": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,64}$"},
        "task_key": {"type": "string", "pattern": "^review\\.(environment|documents|investigate|interpret|verify)(\\.s(00[1-9]|0[1-8][0-9]|09[0-6]))?$", "description": "builder 6부터: 호출이 든 검토 task(전체 역할 또는 slice)"}
      }
    },
    "reviewTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "task_status", "result"],
      "properties": {
        "key": {"type": "string"},
        "task_status": {"type": ["string", "null"]},
        "result": {"enum": ["accepted", "not_planned", "not_succeeded", "result_missing", "result_rejected", "skipped"]},
        "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "description": "task reason code"}
      }
    },
    "aiReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "required_tasks"],
      "properties": {
        "status": {"enum": ["performed", "partial", "not_requested", "not_performed"]},
        "reason": {"type": ["string", "null"]},
        "required_tasks": {"type": "array", "items": {"$ref": "#/$defs/reviewTask"}},
        "optional_tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reviewTask"}, "description": "planned review tasks not required for the verdict; never counted as performed"}
      }
    },
    "toolCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_key", "analyzer", "tool_version", "exit_class", "partial_parse", "files_in_scope", "processed_files", "ignored_files", "unlisted_files", "packages", "stderr_failures", "analyzer_errors", "limitations"],
      "properties": {
        "task_key": {"type": "string"},
        "analyzer": {"type": "string"},
        "tool_version": {"type": ["string", "null"]},
        "exit_class": {"type": "string"},
        "partial_parse": {"type": "boolean"},
        "files_in_scope": {"type": "integer", "minimum": 0},
        "processed_files": {"type": ["integer", "null"], "minimum": 0},
        "ignored_files": {"type": "integer", "minimum": 0},
        "unlisted_files": {"type": "integer", "minimum": 0},
        "packages": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "stderr_failures": {"type": "integer", "minimum": 0},
        "analyzer_errors": {"type": "integer", "minimum": 0},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "processed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "수용된 성공 task에서 도구가 실제 분석한 snapshot 파일. 기록하지 않는 어댑터와 이전 revision은 생략한다."},
        "rule_context": {"$ref": "#/$defs/ruleContext"}
      }
    },
    "ruleContext": {
      "type": "object",
      "description": "도구 버전 외에 어떤 진단을 낼지 정하는 규칙 문맥(docs/ANALYZERS.md#규칙-문맥과-소스-안-억제). 비교는 양쪽 문맥이 알려져 있고 같을 때만 사라진 도구 finding을 resolved_observed로 본다. 없는 행은 문맥을 모르는 것이다(go vet 행은 비교가 합성한다).",
      "additionalProperties": false,
      "required": ["rule_pack", "rule_pack_version", "selection", "repository_config", "source_suppressions", "config"],
      "properties": {
        "rule_pack": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "rule_pack_version": {"type": "string", "minLength": 1},
        "selection": {"type": "array", "items": {"type": "string"}},
        "repository_config": {"enum": ["overridden", "honored", "none"]},
        "source_suppressions": {"enum": ["honored", "reported", "disabled", "none"]},
        "config": {"enum": ["not_read", "recorded", "unrecorded"], "description": "not_read: 저장소 설정을 읽지 않음. recorded: 읽은 설정 파일과 digest를 기록함. unrecorded: 설정을 읽지만 파일을 열거하지 못해 문맥을 모름."},
        "config_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "읽은 저장소 설정 파일(snapshot 경로). 코드 미포함 내보내기에서는 뺀다."},
        "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "읽은 설정 파일의 경로와 manifest SHA-256에 대한 digest. 코드 미포함 내보내기에서는 뺀다."},
        "unreported_suppression_rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$"}, "description": "source_suppressions=reported인데도 억제를 보고하지 않는 규칙. 비교는 이 규칙의 사라진 finding을 해결로 보지 않는다(source_suppressions_hidden). 없으면 생략한다."}
      },
      "allOf": [
        {"if": {"properties": {"repository_config": {"const": "honored"}}}, "then": {"properties": {"config": {"enum": ["recorded", "unrecorded"]}}}, "else": {"properties": {"config": {"const": "not_read"}}}},
        {"if": {"properties": {"config": {"not": {"const": "recorded"}}}}, "then": {"not": {"anyOf": [{"required": ["config_paths"]}, {"required": ["config_digest"]}]}}},
        {"if": {"required": ["unreported_suppression_rules"]}, "then": {"properties": {"source_suppressions": {"const": "reported"}}}}
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_key", "task_execution_id", "name", "status", "exit_code", "reason", "cleanup", "argv", "cwd", "env_keys", "stdout_artifact_id", "stderr_artifact_id", "stdout_truncated", "stderr_truncated", "started_at", "ended_at"],
      "properties": {
        "id": {"type": "string"},
        "task_key": {"type": "string"},
        "task_execution_id": {"type": "string"},
        "name": {"type": "string"},
        "status": {"type": "string"},
        "exit_code": {"type": ["integer", "null"]},
        "reason": {"type": ["string", "null"]},
        "cleanup": {"type": "string"},
        "argv": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string"},
        "env_keys": {"type": "array", "items": {"type": "string"}},
        "stdout_artifact_id": {"type": ["string", "null"]},
        "stderr_artifact_id": {"type": ["string", "null"]},
        "stdout_truncated": {"type": "boolean"},
        "stderr_truncated": {"type": "boolean"},
        "started_at": {"type": ["string", "null"]},
        "ended_at": {"type": ["string", "null"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_key", "role", "media_type", "sha256", "size_bytes", "decoder"],
      "properties": {
        "id": {"type": "string"},
        "task_key": {"type": ["string", "null"]},
        "role": {"type": "string"},
        "media_type": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "decoder": {"type": ["string", "null"]}
      }
    },
    "observationLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "path", "start_line", "end_line", "start_col", "end_col", "column_unit", "blob_sha256"],
      "properties": {
        "snapshot_id": {"type": "string"},
        "path": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "start_col": {"type": "integer", "minimum": 0},
        "end_col": {"type": "integer", "minimum": 0},
        "column_unit": {"const": "byte"},
        "blob_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "rawRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "stream_index", "json_pointer", "byte_start", "byte_end"],
      "properties": {
        "artifact_id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stream_index": {"type": "integer", "minimum": 0},
        "json_pointer": {"type": "string"},
        "byte_start": {"type": "integer", "minimum": 0},
        "byte_end": {"type": "integer", "minimum": 0}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_key", "task_execution_id", "tool", "tool_version", "rule_id", "raw_severity", "raw_message", "location", "location_state", "evidence_state", "raw_ref", "suggested_fix_count"],
      "properties": {
        "id": {"type": "string"},
        "task_key": {"type": "string"},
        "task_execution_id": {"type": "string"},
        "tool": {"type": "string"},
        "tool_version": {"type": ["string", "null"]},
        "rule_id": {"type": "string"},
        "raw_severity": {"type": ["string", "null"]},
        "raw_message": {"type": ["string", "null"]},
        "location": {"anyOf": [{"$ref": "#/$defs/observationLocation"}, {"type": "null"}]},
        "location_state": {"type": "string"},
        "evidence_state": {"enum": ["verified_against_source_manifest", "source_manifest_mismatch", "unresolved"]},
        "raw_ref": {"$ref": "#/$defs/rawRef"},
        "suggested_fix_count": {"type": "integer", "minimum": 0},
        "suppressed": {"type": "boolean", "description": "도구가 소스 안 억제로 숨겨졌다고 보고한 진단. finding이 되지 않고 비교의 suppressed_in_source 판단에만 쓰인다. false는 생략한다."},
        "metric": {"type": "object", "additionalProperties": false, "required": ["name", "value", "threshold", "unit"], "description": "docs/ANALYZERS.md: 임계값(value >= threshold)에 닿은 구조·중복 측정값. 이 관찰은 finding의 근거가 될 수 없다(observation_ids에 오면 보고서 무효). 진단에는 없다.", "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "value": {"type": "integer", "minimum": 0},
          "threshold": {"type": "integer", "minimum": 0},
          "unit": {"enum": ["count", "lines", "tokens"]}}}
      }
    },
    "sectionStage": {"type": "object", "description": "절이 다루는 task의 단계 상태. 실행 화면과 같은 분류기(internal/progress)로 계산한다. not_recorded는 단계 기록이 없는 task가 있는 실행이다.", "additionalProperties": false, "required": ["stage", "state", "tasks", "succeeded", "counts", "reasons"], "properties": {"stage": {"enum": ["environment", "documents", "static_analysis", "code_review", "build", "test"]}, "state": {"enum": ["plan_pending", "no_tasks", "waiting", "running", "succeeded", "skipped", "failed", "cancelled", "partial", "not_recorded"]}, "tasks": {"type": "integer", "minimum": 0}, "succeeded": {"type": "integer", "minimum": 0}, "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}, "reasons": {"type": "array", "items": {"type": "string"}}}},
    "modelInterpretation": {"type": "object", "additionalProperties": false, "required": ["task_key", "state", "task_status", "reason"], "properties": {"task_key": {"type": "string"}, "state": {"enum": ["performed", "not_performed"]}, "task_status": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,63}$"}}, "allOf": [{"if": {"properties": {"state": {"const": "performed"}}}, "then": {"properties": {"reason": {"type": "null"}}}, "else": {"properties": {"reason": {"type": "string"}}}}]},
    "sectionEvidenceID": {"type": "string", "pattern": "^ev_[0-9a-f]{24}$"},
    "documentQuality": {"type": "object", "additionalProperties": false, "required": ["aspect", "assessment", "statement", "evidence_ids"], "properties": {"aspect": {"enum": ["clarity", "completeness", "actionability", "consistency"]}, "assessment": {"enum": ["strength", "weakness"]}, "statement": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/sectionEvidenceID"}, "uniqueItems": true}}},
    "strength": {"type": "object", "additionalProperties": false, "required": ["title", "benefit", "scope", "evidence_ids"], "properties": {"title": {"type": "string", "minLength": 1}, "benefit": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/sectionEvidenceID"}, "uniqueItems": true}}},
    "documentComparison": {"type": "object", "additionalProperties": false, "required": ["statement", "applies_to", "status", "reason", "document_evidence_ids", "code_evidence_ids"], "properties": {"statement": {"type": "string", "minLength": 1}, "applies_to": {"type": "string", "minLength": 1}, "status": {"enum": ["match", "partial", "mismatch", "unknown"]}, "reason": {"type": "string", "minLength": 1}, "document_evidence_ids": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/sectionEvidenceID"}, "uniqueItems": true}, "code_evidence_ids": {"type": "array", "minItems": 0, "maxItems": 4, "items": {"$ref": "#/$defs/sectionEvidenceID"}, "uniqueItems": true}}},
    "sectionEvidence": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "start_line", "end_line", "blob_sha256"], "properties": {"id": {"type": "string", "pattern": "^ev_[0-9a-f]{24}$"}, "kind": {"enum": ["code", "test", "document", "manifest"]}, "path": {"type": "string", "minLength": 1}, "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "excerpt": {"$ref": "https://schemas.codeye.invalid/v0.1/finding.schema.json#/$defs/sourceExcerpt"}, "blob_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "directive_path": {"type": "string", "minLength": 1, "description": "Python docstring을 공개 문서에 연결하는 스냅샷 Markdown 페이지 경로."}}, "if": {"required": ["directive_path"]}, "then": {"properties": {"kind": {"const": "document"}, "path": {"pattern": "\\.py$"}}}},

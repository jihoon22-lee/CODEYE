{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codeye.invalid/v0.1/report.schema.json",
  "title": "CODEYE report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "demo", "id", "run_id", "revision", "created_at", "status", "quality_verdict", "inputs", "summary", "coverage", "tasks", "findings", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "demo": {"type": "boolean"},
    "id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["completed", "partial", "failed", "cancelled"]},
    "quality_verdict": {"enum": ["attention_required", "no_actionable_findings", "inconclusive"]},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "source_kind", "description"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["git", "local", "synthetic"]},
        "description": {"type": "string"},
        "commit_sha": {"type": ["string", "null"]},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile": {"enum": ["deep-review", "with-tests", "focused"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_findings", "actionable_findings", "pending_candidates", "refuted_findings", "priorities"],
      "properties": {
        "total_findings": {"type": "integer", "minimum": 0},
        "actionable_findings": {"type": "integer", "minimum": 0},
        "pending_candidates": {"type": "integer", "minimum": 0},
        "refuted_findings": {"type": "integer", "minimum": 0},
        "priorities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "raw_observations": {"type": "integer", "minimum": 0},
        "unresolved_observations": {"type": "integer", "minimum": 0},
        "hidden_findings": {"type": "integer", "minimum": 1, "description": "W23: 게시 시점의 사람 disposition으로 조치 수에서 숨긴 발견 수(0이면 생략). 전체 수와 비교에는 남는다."},
        "metric_observations": {"type": "integer", "minimum": 1, "description": "W21(docs/45): raw_observations 중 구조 지표(복잡도·중복) 관찰 수(0이면 생략). 결함·finding·조치 수가 아니다."}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_mode", "inventory_files", "tool_processed_files", "llm_exposed_files", "test_status", "notes"],
      "properties": {
        "scope_mode": {"enum": ["full", "paths", "pr"]},
        "inventory_files": {"type": "integer", "minimum": 0},
        "tool_processed_files": {"type": ["integer", "null"], "minimum": 0},
        "llm_exposed_files": {"type": ["integer", "null"], "minimum": 0},
        "test_status": {"enum": ["no_tests", "not_run", "passed", "failed"]},
        "notes": {"type": "array", "items": {"type": "string"}},
        "review_calls": {"type": "array", "maxItems": 15, "items": {"$ref": "#/$defs/reviewCall"}},
        "ai_review": {"$ref": "#/$defs/aiReview"},
        "tools": {"type": "array", "items": {"$ref": "#/$defs/toolCoverage"}}
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "required_for_verdict", "reason"],
        "properties": {
          "id": {"type": "string"},
          "status": {
            "enum": ["succeeded", "failed", "timed_out", "cancelled", "unsupported", "skipped_policy", "budget_exhausted"]
          },
          "required_for_verdict": {"type": "boolean"},
          "reason": {"type": ["string", "null"]},
          "key": {"type": "string"}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "input_digest", "result_manifest_artifact_id"],
      "properties": {
        "id": {"const": "codeye-report"},
        "version": {"type": "string"},
        "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_manifest_artifact_id": {"type": ["string", "null"]}
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_code"],
      "properties": {"include_code": {"type": "boolean"}}
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "lease_epoch", "completion_status", "cleanup_state", "reason"],
      "properties": {
        "id": {"type": "string"},
        "number": {"type": "integer", "minimum": 1},
        "lease_epoch": {"type": "integer", "minimum": 1},
        "completion_status": {"type": "string"},
        "cleanup_state": {"type": "string"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "executions": {"type": "array", "items": {"$ref": "#/$defs/execution"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "reviewCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "model", "opencode_version", "pack_sha256", "request_sha256", "outcome"],
      "properties": {
        "role": {"enum": ["context", "investigate", "verify", "environment", "documents", "interpret"]},
        "model": {"type": "string", "maxLength": 160},
        "opencode_version": {"type": "string", "maxLength": 64},
        "pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "request_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
        "outcome": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$", "description": "review-r1 (schema 0.2) records only"},
        "pack_version": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,64}$"}
      },
      "dependentRequired": {"pack_id": ["pack_version"], "pack_version": ["pack_id"]}
    },
    "reviewTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "task_status", "result"],
      "properties": {
        "key": {"type": "string"},
        "task_status": {"type": ["string", "null"]},
        "result": {"enum": ["accepted", "not_planned", "not_succeeded", "result_missing", "result_rejected", "skipped"]},
        "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "description": "task reason code; review-r1 plans only"}
      }
    },
    "aiReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "required_tasks"],
      "properties": {
        "status": {"enum": ["performed", "partial", "not_requested", "not_performed"]},
        "reason": {"type": ["string", "null"]},
        "required_tasks": {"type": "array", "items": {"$ref": "#/$defs/reviewTask"}},
        "optional_tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reviewTask"}, "description": "planned review tasks not required for the verdict (review-r1); never counted as performed"}
      }
    },
    "toolCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_key", "analyzer", "tool_version", "exit_class", "partial_parse", "files_in_scope", "processed_files", "ignored_files", "unlisted_files", "packages", "stderr_failures", "analyzer_errors", "limitations"],
      "properties": {
        "task_key": {"type": "string"},
        "analyzer": {"type": "string"},
        "tool_version": {"type": ["string", "null"]},
        "exit_class": {"type": "string"},
        "partial_parse": {"type": "boolean"},
        "files_in_scope": {"type": "integer", "minimum": 0},
        "processed_files": {"type": ["integer", "null"], "minimum": 0},
        "ignored_files": {"type": "integer", "minimum": 0},
        "unlisted_files": {"type": "integer", "minimum": 0},
        "packages": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "stderr_failures": {"type": "integer", "minimum": 0},
        "analyzer_errors": {"type": "integer", "minimum": 0},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "processed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "W23: 수용된 성공 task에서 도구가 실제 분석한 snapshot 파일. 기록하지 않는 어댑터와 이전 revision은 생략한다."},
        "rule_context": {"$ref": "#/$defs/ruleContext"}
      }
    },
    "ruleContext": {
      "type": "object",
      "description": "W19(builder 4): 도구 버전 외에 어떤 진단을 낼지 정하는 규칙 문맥(docs/39 §5.1). 비교는 양쪽 문맥이 알려져 있고 같을 때만 사라진 도구 finding을 resolved_observed로 본다. 없는 행은 문맥을 모르는 것이다(go vet 행은 비교가 합성한다).",
      "additionalProperties": false,
      "required": ["rule_pack", "rule_pack_version", "selection", "repository_config", "source_suppressions", "config"],
      "properties": {
        "rule_pack": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "rule_pack_version": {"type": "string", "minLength": 1},
        "selection": {"type": "array", "items": {"type": "string"}},
        "repository_config": {"enum": ["overridden", "honored", "none"]},
        "source_suppressions": {"enum": ["honored", "reported", "disabled", "none"]},
        "config": {"enum": ["not_read", "recorded", "unrecorded"], "description": "not_read: 저장소 설정을 읽지 않음. recorded: 읽은 설정 파일과 digest를 기록함. unrecorded: 설정을 읽지만 파일을 열거하지 못해 문맥을 모름."},
        "config_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "읽은 저장소 설정 파일(snapshot 경로). 코드 미포함 내보내기에서는 뺀다."},
        "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "읽은 설정 파일의 경로와 manifest SHA-256에 대한 digest. 코드 미포함 내보내기에서는 뺀다."},
        "unreported_suppression_rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$"}, "description": "source_suppressions=reported인데도 억제를 보고하지 않는 규칙. 비교는 이 규칙의 사라진 finding을 해결로 보지 않는다(source_suppressions_hidden). 없으면 생략한다."}
      },
      "allOf": [
        {"if": {"properties": {"repository_config": {"const": "honored"}}}, "then": {"properties": {"config": {"enum": ["recorded", "unrecorded"]}}}, "else": {"properties": {"config": {"const": "not_read"}}}},
        {"if": {"properties": {"config": {"not": {"const": "recorded"}}}}, "then": {"not": {"anyOf": [{"required": ["config_paths"]}, {"required": ["config_digest"]}]}}},
        {"if": {"required": ["unreported_suppression_rules"]}, "then": {"properties": {"source_suppressions": {"const": "reported"}}}}
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_key", "task_execution_id", "name", "status", "exit_code", "reason", "cleanup", "argv", "cwd", "env_keys", "stdout_artifact_id", "stderr_artifact_id", "stdout_truncated", "stderr_truncated", "started_at", "ended_at"],
      "properties": {
        "id": {"type": "string"},
        "task_key": {"type": "string"},
        "task_execution_id": {"type": "string"},
        "name": {"type": "string"},
        "status": {"type": "string"},
        "exit_code": {"type": ["integer", "null"]},
        "reason": {"type": ["string", "null"]},
        "cleanup": {"type": "string"},
        "argv": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string"},
        "env_keys": {"type": "array", "items": {"type": "string"}},
        "stdout_artifact_id": {"type": ["string", "null"]},
        "stderr_artifact_id": {"type": ["string", "null"]},
        "stdout_truncated": {"type": "boolean"},
        "stderr_truncated": {"type": "boolean"},
        "started_at": {"type": ["string", "null"]},
        "ended_at": {"type": ["string", "null"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_key", "role", "media_type", "sha256", "size_bytes", "decoder"],
      "properties": {
        "id": {"type": "string"},
        "task_key": {"type": ["string", "null"]},
        "role": {"type": "string"},
        "media_type": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "decoder": {"type": ["string", "null"]}
      }
    },
    "observationLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "path", "start_line", "end_line", "start_col", "end_col", "column_unit", "blob_sha256"],
      "properties": {
        "snapshot_id": {"type": "string"},
        "path": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "start_col": {"type": "integer", "minimum": 0},
        "end_col": {"type": "integer", "minimum": 0},
        "column_unit": {"const": "byte"},
        "blob_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "rawRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "stream_index", "json_pointer", "byte_start", "byte_end"],
      "properties": {
        "artifact_id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stream_index": {"type": "integer", "minimum": 0},
        "json_pointer": {"type": "string"},
        "byte_start": {"type": "integer", "minimum": 0},
        "byte_end": {"type": "integer", "minimum": 0}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_key", "task_execution_id", "tool", "tool_version", "rule_id", "raw_severity", "raw_message", "location", "location_state", "evidence_state", "raw_ref", "suggested_fix_count"],
      "properties": {
        "id": {"type": "string"},
        "task_key": {"type": "string"},
        "task_execution_id": {"type": "string"},
        "tool": {"type": "string"},
        "tool_version": {"type": ["string", "null"]},
        "rule_id": {"type": "string"},
        "raw_severity": {"type": ["string", "null"]},
        "raw_message": {"type": ["string", "null"]},
        "location": {"anyOf": [{"$ref": "#/$defs/observationLocation"}, {"type": "null"}]},
        "location_state": {"type": "string"},
        "evidence_state": {"enum": ["verified_against_source_manifest", "source_manifest_mismatch", "unresolved"]},
        "raw_ref": {"$ref": "#/$defs/rawRef"},
        "suggested_fix_count": {"type": "integer", "minimum": 0},
        "suppressed": {"type": "boolean", "description": "W19: 도구가 소스 안 억제로 숨겨졌다고 보고한 진단. finding이 되지 않고 비교의 suppressed_in_source 판단에만 쓰인다. false는 생략한다."},
        "metric": {"type": "object", "additionalProperties": false, "required": ["name", "value", "threshold", "unit"], "description": "W21(docs/45): 임계값(value >= threshold)에 닿은 구조·중복 측정값. 이 관찰은 finding의 근거가 될 수 없다(observation_ids에 오면 보고서 무효). 진단에는 없다.", "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "value": {"type": "integer", "minimum": 0},
          "threshold": {"type": "integer", "minimum": 0},
          "unit": {"enum": ["count", "lines", "tokens"]}}}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"demo": {"const": false}}}, "then": {"required": ["builder", "export", "attempt", "observations", "executions", "artifacts"], "properties": {"coverage": {"required": ["ai_review", "tools"]}, "summary": {"required": ["raw_observations", "unresolved_observations"]}}}},
    {"$comment": "W23: 코드 미포함 내보내기는 fingerprint·basis·move_key를 싣지 않는다(코드에서 나온 입력의 비keyed digest라 추측한 코드를 확인할 수 있다). W19: 도구 행 rule_context의 config_paths·config_digest도 같은 이유로 싣지 않는다.",
     "if": {"required": ["export"], "properties": {"export": {"required": ["include_code"], "properties": {"include_code": {"const": false}}}}},
     "then": {"properties": {"findings": {"items": {"not": {"anyOf": [{"required": ["fingerprint"]}, {"required": ["fingerprint_basis"]}, {"required": ["disposition_version"]}]}}},
       "coverage": {"properties": {"tools": {"items": {"properties": {"rule_context": {"not": {"anyOf": [{"required": ["config_paths"]}, {"required": ["config_digest"]}]}}}}}}}}}}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codeye.invalid/v0.1/plan.schema.json",
  "title": "CODEYE analysis plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "revision", "tasks"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "purpose", "scope", "depends_on", "required_for_verdict", "capabilities", "weight", "resource_request", "budget", "completion_contract"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["discover", "prepare", "analyzer", "llm_review", "verify", "synthesize", "report", "build", "test"]},
        "purpose": {"type": "string", "minLength": 1},
        "scope": {"type": "object", "additionalProperties": false, "required": ["kind", "paths"], "properties": {"kind": {"enum": ["full", "paths", "pr"]}, "paths": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_for_verdict": {"type": "boolean"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "resource_request": {"type": "object", "additionalProperties": false, "required": ["cpu_cores", "memory_mb"], "properties": {"cpu_cores": {"type": "number", "exclusiveMinimum": 0}, "memory_mb": {"type": "integer", "minimum": 32}}},
        "budget": {"type": "object", "additionalProperties": false, "required": ["timeout_seconds"], "properties": {"timeout_seconds": {"type": "integer", "minimum": 1}, "token_limit": {"type": "integer", "minimum": 1}, "model_calls": {"type": "integer", "minimum": 1}}},
        "completion_contract": {"type": "string", "minLength": 1}
      }
    }
  }
}

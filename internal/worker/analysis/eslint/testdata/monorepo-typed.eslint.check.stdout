SON.parse(raw);\n  return value.count;\n}\n\nexport function label(user: User): string {\n  const unused = user.id;\n  return user.name;\n}\n\nexport const total: number = \"3\";\n","usedDeprecatedRules":[]},{"filePath":"[REDACTED]/packages/app/src/suppressed.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"[REDACTED]/packages/app/src/util.ts","messages":[{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async function 'fetchUser' has no 'await' expression.","line":6,"column":8,"messageId":"missingAwait","endLine":6,"endColumn":32,"suggestions":[{"messageId":"removeAsync","fix":{"range":[64,115],"text":"function fetchUser(id: string): User"},"desc":"Remove 'async'."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"export interface User {\n  id: string;\n  name: string;\n}\n\nexport async function fetchUser(id: string): Promise<User> {\n  return { id, name: \"user-\" + id };\n}\n","usedDeprecatedRules":[]},{"filePath":"[REDACTED]/packages/app/tools/gen.ts","messages":[{"ruleId":null,"fatal":true,"severity":2,"message":"Parsing error: \"parserOptions.project\" has been provided for @typescript-eslint/parser.\nThe file was not found in any of the provided project(s): tools/gen.ts"}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"export function generate(name: string): string {\n  let out = \"gen-\" + name;\n  return out;\n}\n","usedDeprecatedRules":[]}]

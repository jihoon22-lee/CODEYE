[{"filePath":"[REDACTED]/packages/app/src/index.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":19,"column":16,"messageId":"unexpectedAny","endLine":19,"endColumn":19,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[399,402],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[399,402],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'unused' is assigned a value but never used.","line":24,"column":9,"messageId":"unusedVar","endLine":24,"endColumn":15}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { fetchUser, type User } from \"./util\";\n\nexport async function load(ids: string[]): Promise<User[]> {\n  const out: User[] = [];\n  for (const id of ids) {\n    out.push(await fetchUser(id));\n  }\n  return out;\n}\n\nexport function start(ids: string[]): void {\n  load(ids);\n  ids.forEach(async (id) => {\n    await fetchUser(id);\n  });\n}\n\nexport function count(raw: string): number {\n  const value: any = JSON.parse(raw);\n  return value.count;\n}\n\nexport function label(user: User): string {\n  const unused = user.id;\n  return user.name;\n}\n\nexport const total: number = \"3\";\n","usedDeprecatedRules":[]},{"filePath":"[REDACTED]/packages/app/src/suppressed.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":2,"column":21,"messageId":"unexpectedAny","endLine":2,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[124,127],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[124,127],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// eslint-disable-next-line @typescript-eslint/no-explicit-any -- the managed config ignores directives\nexport const loose: any = 1;\n\n// @ts-expect-error tsc honors this directive and reports nothing for it\nexport const hidden: number = \"x\";\n","usedDeprecatedRules":[]},{"filePath":"[REDACTED]/packages/app/src/util.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"[REDACTED]/packages/app/tools/gen.ts","messages":[{"ruleId":"prefer-const","severity":2,"message":"'out' is never reassigned. Use 'const' instead.","line":2,"column":7,"messageId":"useConst","endLine":2,"endColumn":10,"fix":{"range":[51,75],"text":"const out = \"gen-\" + name;"}}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"export function generate(name: string): string {\n  let out = \"gen-\" + name;\n  return out;\n}\n","usedDeprecatedRules":[]}]

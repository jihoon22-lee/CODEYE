[{"filePath":"[REDACTED]/request.js","messages":[{"ruleId":"prefer-promise-reject-errors","severity":1,"message":"Expected the Promise rejection reason to be an Error.","line":2,"column":10,"messageId":"rejectAnError","endLine":2,"endColumn":54},{"ruleId":"prefer-promise-reject-errors","severity":1,"message":"Expected the Promise rejection reason to be an Error.","line":6,"column":55,"messageId":"rejectAnError","endLine":6,"endColumn":66}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"export function request(message) {\n  return Promise.reject(\"Request failed: \" + message);\n}\nexport function upload(open) {\n  return new Promise((resolve, reject) => {\n    queueMicrotask(() => open ? resolve(\"Uploaded\") : reject(404));\n  });\n}\nexport const fromUnknown = (reason) => Promise.reject(reason);\nexport const fromError = () => Promise.reject(new Error(\"Failed\"));\nexport const fromNoReason = () => Promise.reject();\nexport const fromCustomPromise = (Promise) => Promise.reject(\"Expected\");\nexport const fromCustomCallback = (reject) => reject(\"Expected\");\n","usedDeprecatedRules":[]},{"filePath":"[REDACTED]/src/request.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}]

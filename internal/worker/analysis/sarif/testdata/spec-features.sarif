{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Example",
          "version": "1.0",
          "informationUri": "https://example.com/tool",
          "rules": [
            {
              "id": "R1",
              "name": "PathTraversal",
              "shortDescription": {"text": "path from input"},
              "defaultConfiguration": {"level": "warning"},
              "properties": {"tags": ["security", "external/cwe/cwe-22", "CWE-22", "CWE-23: Relative Path Traversal"], "precision": "high"}
            },
            {
              "id": "R2",
              "shortDescription": {"text": "note"},
              "defaultConfiguration": {"level": "note"}
            }
          ]
        }
      },
      "originalUriBaseIds": {"TOOLHOME": {"uri": "file:///opt/tool/"}},
      "invocations": [{"executionSuccessful": true, "toolExecutionNotifications": []}],
      "results": [
        {
          "ruleId": "R1",
          "level": "error",
          "message": {"text": "first"},
          "locations": [
            {"physicalLocation": {"artifactLocation": {"uri": "src/a%20b.c", "uriBaseId": "SRCROOT"}, "region": {"startLine": 3, "startColumn": 2, "endLine": 3, "endColumn": 9}}},
            {"physicalLocation": {"artifactLocation": {"uri": "src/b.c", "uriBaseId": "SRCROOT"}, "region": {"startLine": 1}}}
          ],
          "relatedLocations": [
            {"id": 1, "message": {"text": "declared here"}, "physicalLocation": {"artifactLocation": {"uri": "src/c.c"}, "region": {"startLine": 7}}}
          ],
          "codeFlows": [
            {"threadFlows": [{"locations": [
              {"location": {"message": {"text": "source"}, "physicalLocation": {"artifactLocation": {"uri": "src/a%20b.c"}, "region": {"startLine": 1}}}, "nestingLevel": 0},
              {"kinds": ["call"], "location": {"message": {"text": "sink"}, "physicalLocation": {"artifactLocation": {"uri": "src/a%20b.c"}, "region": {"startLine": 3}}}, "nestingLevel": 0}
            ]}]}
          ],
          "partialFingerprints": {"primaryLocationLineHash": "abc:1"},
          "suppressions": [{"kind": "inSource", "justification": "reviewed"}]
        },
        {
          "ruleIndex": 1,
          "message": {"text": "second"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/b.c"}, "region": {"startLine": 2}}}],
          "suppressions": [{"kind": "external", "status": "rejected"}]
        },
        {
          "ruleId": "R2",
          "message": {"text": "third"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "../../etc/passwd"}, "region": {"startLine": 1}}}],
          "relatedLocations": [{"physicalLocation": {"artifactLocation": {"uri": "file:///etc/hosts"}, "region": {"startLine": 1}}}]
        }
      ]
    }
  ]
}

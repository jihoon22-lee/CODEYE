{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": [
            "es2022"
        ],
        "strict": true,
        "noEmit": true,
        "incremental": false,
        "composite": false,
        "ignoreDeprecations": "6.0",
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": false
    },
    "files": [
        "./src/bad.ts",
        "./src/ok.ts"
    ],
    "include": [
        "src"
    ]
}

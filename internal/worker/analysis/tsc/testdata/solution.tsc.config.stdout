{
    "compilerOptions": {
        "noEmit": true,
        "incremental": false,
        "composite": false,
        "ignoreDeprecations": "6.0",
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": false
    },
    "references": [
        {
            "path": "./tsconfig.app.json"
        },
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
